# BizNexus Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/biznexus

# CORS Configuration
CLIENT_URL=http://localhost:5173

# API Versioning
API_PREFIX=/api

# JWT Authentication
JWT_SECRET=replace_with_strong_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MINUTES=60
